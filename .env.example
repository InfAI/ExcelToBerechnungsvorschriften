# OpenAI API Key (gpt-4o-mini)
OPENAI_API_KEY=sk-your-api-key-here

# LLM Temperatur (0.0–1.0, Standard: 0.3 für konsistentere Formel-Extraktion)
# LLM_TEMPERATURE=0.3

# Fuseki Dataset Name
FUSEKI_DATASET=berechnungsvorschriften

# RDF Namespace (IRI) für Berechnungsvorschriften
RDF_NAMESPACE=http://example.org/berechnungsvorschrift/

# Fuseki Credentials
FUSEKI_USER=admin
FUSEKI_PASSWORD=your-password-here
